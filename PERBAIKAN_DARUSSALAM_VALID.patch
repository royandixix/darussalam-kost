+
+    $this->actingAs($firstUser)
+        ->post(route('user.bookings.store'), [
+            'room_id' => $room->id,
+            'check_in_date' => now()->addDay()->toDateString(),
+            'duration_month' => 6,
+            'payment_method' => 'cod',
